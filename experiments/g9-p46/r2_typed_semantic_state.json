  "ancestry": [
    "KSGT 0.2.8 Argument Memory / Result-state Graph / Predicate-conditioned Sense",
    "KSGT 0.2.9 EventChain / ActualityLayer / DiscourseTransitionModel",
    "KSGT 0.2.11 Projection Composition / Frame Families / Structured Abstention",
    "G8-P3 M4 Projection-Relative Observational Congruence",
    "G9-P17 Authority-Labeled Support-Subgraph Quotient",
    "G9-P36 KSGT-ARG-v1.1 argument-recoverability graph"
  ],
  "principle": "TYPED_GRAPH_FIELDS_ARE_PROTECTED_ONLY_RELATIVE_TO_DECLARED_PROJECTION_AND_AUTHORITY",
  "state_fields": {
    "predicate_sense": {
      "type": "set_or_unknown",
      "role": "candidate event/predicate identity"
    },
    "arguments": {
      "type": "typed_role_graph_or_unknown",
      "role": "argument/recoverability structure; particle != semantic role"
    },
    "actuality": {
      "type": "actual_hypothetical_negated_reported_unknown",
      "role": "event actuality/modal status"
    },
    "temporal_causal": {
      "type": "typed_edges_or_unknown",
      "role": "event order/result/reversal/cancellation"
    },
    "projection_world": {
      "type": "nested_typed_world_graph_or_unknown",
      "role": "matrix/embedded/report/belief/desire/quote etc."
    },
    "negation_scope": {
      "type": "typed_scope_or_unknown",
      "role": "distinguish NEG(report(P)) vs report(NEG(P))"
    },
    "discourse_relation": {
      "type": "set_or_unknown",
      "role": "relation candidate, never inferred from lexical marker alone"
    },
    "attribution_source": {
      "type": "typed_or_unknown",
      "role": "who/what bears proposition or quoted content"
    },
    "information_structure": {
      "type": "typed_or_unknown",
      "role": "retained only when target projection needs it"
    },
    "relational_stance_register": {
      "type": "typed_or_unknown",
      "role": "not automatically surface; may affect downstream relational meaning"
    },
    "support_state": {
      "type": "EXACT_VALIDATED_COMPOSED_INDUCED_UNSUPPORTED_CONFLICTED",
      "role": "evidence authority"
    },
    "decision_state": {
      "type": "AUTO_REVIEW_ABSTAIN_BLOCK",
      "role": "structured uncertainty/action"
    }
  },
  "forbidden_collapses": [
    "UNRECOGNIZED_CONSTRUCTION=>SIMPLE_EXACT",
    "LEXICAL_MARKER=>DISCOURSE_RELATION_GOLD",
    "PARTICLE=>SEMANTIC_ROLE_IDENTITY",
    "SAME_PROPOSITION=>SAME_FULL_REALIZATION_STATE",
    "SPEECH_LEVEL=>PURE_SURFACE_BY_DEFAULT",
    "NEWER_ANALYZER_UNKNOWN=>ERASE_OLDER_SUPPORTED_FACT"
  ],
  "projection_contract": {
    "Q_core": [
      "predicate_sense",
      "arguments",
      "actuality",
      "projection_world",
      "negation_scope",
      "attribution_source"
    ],
    "Q_dynamic": [
      "temporal_causal",
      "discourse_relation",
      "information_structure",
      "relational_stance_register"
    ],
    "Q_authority": [
      "support_state",
      "decision_state"
    ],
    "note": "Actual active Q is task-specific; this list is a candidate field bank, not a universal semantic ontology."
  },
  "quotient_rule": "Two typed states may collapse only if their declared Sigma_{Q,D} signatures agree over the frozen downstream refinement family D and authority state agrees.",
  "surface_fiber_candidate": [
    "lexical/discourse-marker realization",
    "local word order only when information-structure projection is unchanged",
    "recoverable argument omission only when predicate/role/authority remain preserved",
    "orthographic/punctuation realization only when no declared discourse/prosodic effect changes"
  ],
  "reentry_boundary": {
