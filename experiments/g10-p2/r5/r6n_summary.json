{
  "authority": "AUTHORED_SPAN_CONTRACTS_ONLY",
  "fullReceiptSHA256": "88542d83c589a9691c07687b8f6a71ae0ad5474991f71920b10339f7e6d2d237",
  "rows": [
    {
      "id": "archive",
      "fixedCost": 180,
      "jointCost": 180,
      "fixedOrder": [
        "entry",
        "people",
        "folder",
        "leave",
        "later",
        "unknown"
      ],
      "jointOrder": [
        "entry",
        "people",
        "folder",
        "leave",
        "later",
        "unknown"
      ],
      "jointText": "민서는 열람실에 들어와 지우와 서현이 같은 책상에 앉아 있는 모습을 보았다. 지우는 파란 파일을 펼쳤고 서현은 열람실을 나갔다.\n\n나중에 지우는 민서에게 그 파일이 목록이라고 말했다. 민서는 목록의 내용도, 서현이 나간 이유도 확인하지 못했다.",
      "sentences": 4,
      "length": 136
    },
    {
      "id": "trial",
      "fixedCost": 253,
      "jointCost": 253,
      "fixedOrder": [
        "setup",
        "a",
        "b",
        "heater",
        "limit",
        "bLimit"
      ],
      "jointOrder": [
        "setup",
        "a",
        "b",
        "heater",
        "limit",
        "bLimit"
      ],
      "jointText": "같은 날 용기 A와 B를 관찰했다. A의 수온은 오전 20도에서 오후 22도로 변했다. 반면 B는 오후에 20도였고 오전 기록은 없다. A에는 오후에 가열 장치를 연결한 기록이 있으나 작동 여부는 기록되지 않았다.\n\nA의 수온 변화가 장치 연결 때문인지는 확인하지 않았다. B의 경우에는 오전 기록이 없어 수온 차이를 판단할 수 없다.",
      "sentences": 6,
      "length": 187
    },
    {
      "id": "notice",
      "fixedCost": 194,
      "jointCost": 194,
      "fixedOrder": [
        "start",
        "open",
        "return",
        "pending",
        "route",
        "promise"
      ],
      "jointOrder": [
        "start",
        "open",
        "return",
        "pending",
        "route",
        "promise"
      ],
      "jointText": "월요일부터 2층 자료실 정리를 시작합니다. 정리 중에도 1층 열람실은 이용할 수 있으며, 책은 1층 반납함에 넣어 주시기 바랍니다.\n\n2층 자료실의 정리 완료일과 재개 후 이동 동선은 아직 정해지지 않았습니다. 이번 안내는 정리 시작과 현재 이용 방법에 관한 것입니다.",
      "sentences": 4,
      "length": 150
    },
    {
      "id": "team",
      "fixedCost": 217,
      "jointCost": 217,
      "fixedOrder": [
        "read",
        "criteria",
        "message",
        "proposal",
        "result",
        "next"
      ],
      "jointOrder": [
        "read",
        "criteria",
        "message",
        "proposal",
        "result",
        "next"
      ],
      "jointText": "공개 초록을 읽어 봤는데, 표본을 나눈 기준이 나와 있더라. 전문은 아직 못 읽었어. 지현이는 팀 문서에서 그 기준을 찾지 못했다고 했어.\n\n팀 문서에 그 기준을 추가하면 좋겠어. 두 연구의 결과가 일치하는지는 아직 확인 못 했어. 결과 비교는 전문을 읽고 나서 하자.",
      "sentences": 6,
      "length": 150
    },
    {
      "id": "lists",
      "fixedCost": 189,
      "jointCost": 189,
      "fixedOrder": [
        "old",
        "new",
        "call",
        "check",
        "unknown",
        "scope"
      ],
      "jointOrder": [
        "old",
        "new",
        "call",
        "check",
        "unknown",
        "scope"
      ],
      "jointText": "수아는 지난달 대출 목록을 책상 위에 놓았고, 윤호는 그 옆에 이번 달 대출 목록을 놓았다. 잠시 뒤 수아가 담당자의 전화를 받았다.\n\n이후 수아는 지난달 대출 목록을 확인했다. 이번 달 목록을 확인했는지, 두 목록 중 어느 하나라도 수정했는지는 기록에 없다.",
      "sentences": 4,
      "length": 145
    },
    {
      "id": "exhibit",
      "fixedCost": 223,
      "jointCost": 223,
      "fixedOrder": [
        "layout",
        "print",
        "test",
        "report",
        "plan",
        "status"
      ],
      "jointOrder": [
        "layout",
        "print",
        "test",
        "report",
        "plan",
        "status"
      ],
      "jointText": "오전에 전시 담당자가 안내판 두 개를 옮겼다. 오후에는 학생팀이 안내문을 인쇄하고, 인쇄를 마친 뒤 안내문 한 장을 읽기 쉽게 배치했다.\n\n담당자는 안내판 위치를 다시 검토할 수 있다고 했고, 학생팀은 나머지 안내문도 같은 방식으로 배치하자고 제안했다. 안내판 위치 변경이나 나머지 안내문 배치가 완료됐다는 기록은 없다.",
      "sentences": 4,
      "length": 179
    },
    {
      "id": "repair",
      "fixedCost": 236,
      "jointCost": 232,
      "fixedOrder": [
        "start",
        "a",
        "note",
        "b",
        "afternoon",
        "reply",
        "pending",
        "end"
      ],
      "jointOrder": [
        "start",
        "b",
        "a",
        "note",
        "afternoon",
        "reply",
        "pending",
        "end"
      ],
      "jointText": "오전에 두 자료실의 상태를 확인했다. B실의 반납함 위치와 A실의 서가 번호를 확인했다. 번호를 점검표에 적었다. 오후에 점검표를 담당자에게 전달했다.\n\n담당자는 A실 번호를 다시 확인할 수 있다고 말했다. B실 반납함을 옮길지는 미정이다. 추가 작업 완료일은 정해지지 않았다.",
      "sentences": 7,
      "length": 155
    },
    {
      "id": "letters",
      "fixedCost": 208,
      "jointCost": 208,
      "fixedOrder": [
        "enter",
        "white",
        "open",
        "blue",
        "leave",
        "report",
        "unknown",
        "reason"
      ],
      "jointOrder": [
        "enter",
        "white",
        "open",
        "blue",
        "leave",
        "report",
        "unknown",
        "reason"
      ],
      "jointText": "하린은 작업실에 들어왔다. 은서가 흰 봉투를 책상에 놓고 여는 모습이 보였다. 민재는 파란 봉투를 선반에 놓았고 작업실을 나갔다.\n\n나중에 은서는 하린에게 흰 봉투에 안내문이 있었다고 말했다. 하린은 안내문의 내용과 파란 봉투의 내용물, 민재가 나간 이유를 확인하지 못했다.",
      "sentences": 5,
      "length": 153
    }
  ],
