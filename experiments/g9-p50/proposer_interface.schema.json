{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ksgt.g9.p50.proposer-interface.v1",
  "title": "KSGT G9-P50 Common Proposer Interface",
  "type": "object",
  "required": [
    "source_id",
    "task_context",
    "candidate_text",
    "candidate_provenance",
    "proposer_family",
    "checkpoint_id"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "task_context": {
      "type": "object",
      "additionalProperties": true
    },
    "candidate_text": {
      "type": "string"
    },
    "candidate_provenance": {
      "type": "object",
      "required": [
        "generation_route"
      ],
      "properties": {
        "generation_route": {
          "type": "string"
        },
        "candidate_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retrieval_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edit_script_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "proposer_score_if_defined": {
      "type": [
        "number",
        "null"
      ]
    },
    "proposer_family": {
      "type": "string",
      "enum": [
        "SLM_AR",
        "RIVAL_EDIT"
      ]
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_budget": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "authority_note": "Interface fields are transport metadata. Presence of proposer_score_if_defined does not grant ranking or semantic authority."
}
